#. module: fullyn_field_connector
#. odoo-python
#: code:addons/fullyn_field_connector/models/res_config_settings.py:0
msgid ""
"Fullyn Field for Odoo supports Odoo 19 and 20. On another version, connect "
"Odoo to Fullyn Field through the Fullyn platform API."
msgstr ""
"Fullyn Field for Odoo est disponible pour Odoo 19 et 20. Sur une autre "
"version, connectez Odoo à Fullyn Field via l'API de la plateforme Fullyn."

