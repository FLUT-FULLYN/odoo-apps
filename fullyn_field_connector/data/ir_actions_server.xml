<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_fullyn_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'fullyn_field_connector', 'bin_size': False}</field>
    </record>

    <record id="action_fullyn_open_platform" model="ir.actions.server">
        <field name="name">Open the Fullyn platform</field>
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="state">code</field>
        <field name="code">action = model.fullyn_action_open_platform()</field>
    </record>

    <record id="action_fullyn_book_demo" model="ir.actions.server">
        <field name="name">Book a demo</field>
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="state">code</field>
        <field name="code">action = model.fullyn_action_book_demo()</field>
    </record>
</odoo>
