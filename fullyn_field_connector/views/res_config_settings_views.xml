<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fullyn_field_connector</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Fullyn Field" string="Fullyn Field" name="fullyn_field_connector"
                     groups="base.group_system">
                    <block title="Connection to Fullyn" name="fullyn_connection">
                        <setting id="fullyn_platform_url_setting"
                                 string="Fullyn platform"
                                 help="Address of your Fullyn platform. Default: https://app.fullyn.com">
                            <field name="fullyn_platform_url" placeholder="https://app.fullyn.com"/>
                        </setting>
                        <setting id="fullyn_api_key_setting"
                                 string="API key"
                                 help="Key of your Fullyn account, available from your Fullyn administrator.">
                            <field name="fullyn_api_key" password="True"/>
                        </setting>
                        <setting id="fullyn_consent_setting"
                                 help="Required before any exchange. The connection test only sends the API key and the module version to the Fullyn platform. No employee, project or timesheet data is sent by this module.">
                            <field name="fullyn_data_consent"/>
                        </setting>
                        <setting id="fullyn_test_setting"
                                 string="Connection test">
                            <div class="text-muted">
                                <field name="fullyn_last_check" readonly="1" class="w-100"/>
                            </div>
                            <div class="mt8">
                                <button name="action_fullyn_test_connection" type="object"
                                        string="Test connection" class="btn-primary"/>
                                <button name="action_fullyn_open_platform" type="object"
                                        string="Open the Fullyn platform" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Readiness check (local, nothing is sent)" name="fullyn_readiness">
                        <setting id="fullyn_readiness_figures" string="Your database">
                            <div class="row mt8">
                                <label for="fullyn_odoo_version" class="col-lg-5 o_light_label"/>
                                <field name="fullyn_odoo_version" readonly="1"/>
                            </div>
                            <div class="row">
                                <label for="fullyn_employee_count" class="col-lg-5 o_light_label"/>
                                <field name="fullyn_employee_count" readonly="1"/>
                            </div>
                            <div class="row">
                                <label for="fullyn_project_count" class="col-lg-5 o_light_label"/>
                                <field name="fullyn_project_count" readonly="1"/>
                            </div>
                        </setting>
                        <setting id="fullyn_readiness_apps" string="Related Odoo apps">
                            <field name="fullyn_apps_status" readonly="1" class="w-100"/>
                        </setting>
                        <setting id="fullyn_readiness_reco" string="Recommendation">
                            <field name="fullyn_recommendation" readonly="1" class="w-100"/>
                            <div class="mt8">
                                <button name="action_fullyn_book_demo" type="object"
                                        string="Book a demo" class="btn-secondary"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
